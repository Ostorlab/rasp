{
  "schema_version": 1,
  "scope": "Portable native contract fixtures, not transport schema or device results.",
  "cases": [
    {
      "name": "benign_assistive_metadata",
      "platform": "android",
      "api_level": 35,
      "interpretation": "Enabled services and selected assistive IME; no malware verdict or active-control assertion.",
      "observations": [
        {
          "signal": "a11y.enabled_services",
          "source": "accessibility_manager",
          "status": "ok",
          "value": [
            "com.google.android.marvin.talkback/com.google.android.marvin.talkback.TalkBackService capabilities=1 flags=0",
            "org.password/org.password.FillService capabilities=1 flags=128"
          ]
        },
        {
          "signal": "ime.enabled_components",
          "source": "input_method_manager",
          "status": "ok",
          "value": [
            "org.assist/org.assist.Keyboard"
          ]
        },
        {
          "signal": "ime.current_component",
          "source": "input_method_manager",
          "status": "ok",
          "value": "org.assist/org.assist.Keyboard"
        },
        {
          "signal": "notification.enabled_listeners",
          "source": "settings_secure",
          "status": "ok",
          "value": [
            "org.support/org.support.Listener"
          ]
        }
      ]
    },
    {
