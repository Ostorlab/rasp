        {
          "signal": "ime.enabled_components",
          "source": "input_method_manager",
          "status": "ok",
          "value": [
            "org.assist/org.assist.Keyboard",
            "org.example/org.example.Keyboard"
          ]
        },
        {
          "signal": "ime.current_component",
          "source": "input_method_manager",
          "status": "ok",
          "value": "org.example/org.example.Keyboard"
        },
        {
          "signal": "notification.enabled_listeners",
          "source": "settings_secure",
          "status": "ok",
          "value": [
            "org.example/org.example.Listener"
          ]
        }
      ]
    },
