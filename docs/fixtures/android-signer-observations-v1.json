  "legacy_semantics": "sig.cert_sha256 remains a scalar first-signer digest; proc_cmdline is a process-name-derived legacy value",
  "observations": [
    {
      "signal": "id.package.v1",
      "source": "application_context",
      "value_kind": "string",
      "cardinality": "one",
      "value_cardinality": "scalar",
      "statuses": [
        "ok",
        "error",
        "unsupported"
      ],
      "supported_on": "android",
      "behavior": "Actual retained Application.getPackageName via supported Context only, independent of global process aliases; no ActivityThread fallback. API31+. Missing Context/JNI/permission or null/empty/malformed/over-255-character package is error without a value. Public owned package metadata only, not attestation."
    },
    {
      "signal": "sig.current_sha256.v1",
      "source": "apk_signing_block",
      "value_kind": "string_list",
      "cardinality": "one",
      "value_cardinality": "variable",
      "statuses": [
        "ok",
        "error",
        "unsupported"
      ],
      "supported_on": "android",
      "behavior": "Complete sorted unique lowercase SHA256 digests of current signer leaves for exactly one applicable v2/v3/v3.1 scheme; chain entries and rotation history are not concurrent signers. API31+, v3.1 from API33; at most ten v2 signers, one applicable v3/v3.1 signer. Bounded ZIP32 region reads; missing/malformed/empty/over-limit input is error, unsupported scheme selection is unsupported, never OK empty. Untrusted file hashes, not signature or lineage verification."
    },
    {
      "signal": "sig.current_sha256.v1",
      "source": "package_manager",
      "value_kind": "string_list",
      "cardinality": "one",
      "value_cardinality": "variable",
      "statuses": [
        "ok",
        "error",
        "unsupported"
      ],
      "supported_on": "android",
      "behavior": "Complete current getApkContentsSigners digests for the retained Application owned package using GET_SIGNING_CERTIFICATES, sorted unique lowercase SHA256. Supported Context only, API31+. At most32 raw certificates,64KiB each and256KiB aggregate before deduplication. Missing Context/JNI/permission, null/empty/malformed/over-limit array is error without a partial or empty clean set. History is separate; no signature/attestation proof."
    },
    {
      "signal": "sig.history_sha256.v1",
      "source": "package_manager",
      "value_kind": "string_list",
      "cardinality": "one",
      "value_cardinality": "variable",
      "statuses": [
        "ok",
        "error",
        "unsupported"
      ],
      "supported_on": "android",
      "behavior": "Public SigningInfo.getSigningCertificateHistory digests in oldest-to-current order including current; singleton without rotation, unsupported for validated parallel signing and never treated as concurrent current signers. Supported retained Context, owned package and API31+. At most32 certificates,64KiB each and256KiB aggregate. Missing/null/empty/malformed/over-limit history or terminal mismatch is error without a value. No local lineage verification or signing-registry trust claim."
    }
  ],
