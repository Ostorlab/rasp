<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Normal (install-time) permissions for the fraud protections. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Per-use confirmation for the user-auth-bound device key. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Package visibility for root-manager detection (Android 11+). Keep in sync with PlatformDetectors.ROOT_PACKAGES. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="org.lsposed.manager" />
        <package android:name="de.robv.android.xposed.installer" />
        <!-- Remote-access apps used in banking scams. Keep in sync with FraudDetectors.REMOTE_ACCESS_PACKAGES. -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
        <package android:name="com.splashtop.remote.pad.v2" />
        <package android:name="com.rsupport.mvagent" />
        <package android:name="com.logmein.rescuemobile" />
        <package android:name="com.remotepc.viewer" />
        <!-- Accessibility services, to read the installer of an enabled service. -->
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
    </queries>
</manifest>
