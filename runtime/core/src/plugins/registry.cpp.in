/// compiled_in: the plugins compiled into the runtime, generated by the build from the plugins it was given.
///
/// This is a template. rasp_plugin_registry() in cmake/plugins.cmake copies it into the build directory and replaces
/// each placeholder below (a variable name between two at signs), once per configure, for the plugins listed in
/// RASP_PLUGINS.

#include <array>
#include <span>

#include "rasp/plugin.h"
#include "rasp/plugins/registry.h"

// One declaration per plugin, of the kPlugin it defines in its own namespace, such as:
//   namespace rasp::plugins::example {
//   extern const Plugin kPlugin;
//   }  // namespace rasp::plugins::example
// Empty when no plugin is compiled in.
@RASP_PLUGIN_DECLARATIONS@

namespace rasp::plugins {

// The count is the number of plugins, and the addresses are their kPlugin, in RASP_PLUGINS order, such as
// `&example::kPlugin, &other::kPlugin`. Taking each address also makes the linker keep the plugin's code.
std::span<const Plugin* const> compiled_in() {
  static constexpr std::array<const Plugin*, @RASP_PLUGIN_COUNT@> kPlugins{@RASP_PLUGIN_ADDRESSES@};
  return kPlugins;
}

}  // namespace rasp::plugins
