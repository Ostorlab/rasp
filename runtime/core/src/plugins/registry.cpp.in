/// compiled_in: the plugins compiled into the runtime, generated by the build from the plugins it was given.

#include <array>
#include <span>

#include "rasp/plugin.h"
#include "rasp/plugins/registry.h"

@RASP_PLUGIN_DECLARATIONS@namespace rasp::plugins {

std::span<const Plugin* const> compiled_in() {
  static constexpr std::array<const Plugin*, @RASP_PLUGIN_COUNT@> kPlugins{@RASP_PLUGIN_ADDRESSES@};
  return kPlugins;
}

}  // namespace rasp::plugins
