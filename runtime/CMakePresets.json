{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Development machine, with the tests",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RASP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS device (arm64)",
      "binaryDir": "${sourceDir}/build/ios",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    }
  ],
  "buildPresets": [
    {"name": "host", "configurePreset": "host"},
    {"name": "ios", "configurePreset": "ios"}
  ],
  "testPresets": [
    {"name": "host", "configurePreset": "host", "output": {"outputOnFailure": true}}
  ]
}
