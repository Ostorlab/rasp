"""Type stubs for the native core of the dex splitter (dexsplit._dex)."""

import collections.abc

class MethodId:
    @property
    def class_descriptor(self) -> str: ...

class FieldId:
    @property
    def class_descriptor(self) -> str: ...

class ClassRef:
    @property
    def descriptor(self) -> str: ...

class MethodCall:
    @property
    def target(self) -> MethodId: ...

class FieldAccess:
    @property
    def field(self) -> FieldId: ...

class TypeUse:
    @property
    def descriptor(self) -> str: ...

class Method:
    @property
    def calls(self) -> list[MethodCall]: ...
    @property
    def field_accesses(self) -> list[FieldAccess]: ...
    @property
    def type_uses(self) -> list[TypeUse]: ...

class Class:
    @property
    def name(self) -> str: ...
    @property
    def superclass(self) -> ClassRef | None: ...
    @property
    def interfaces(self) -> list[ClassRef]: ...
    @property
    def methods(self) -> list[Method]: ...

class AnalysisContext:
    @staticmethod
    def from_models(models: list[Model]) -> AnalysisContext: ...
    @staticmethod
    def from_dex_buffers(dexes: list[bytes]) -> AnalysisContext: ...
    @property
    def classes(self) -> list[Class]: ...

class PoolStats:
    @property
    def strings(self) -> int: ...
    @property
    def types(self) -> int: ...
    @property
    def protos(self) -> int: ...
    @property
    def fields(self) -> int: ...
    @property
    def methods(self) -> int: ...
    @property
    def method_handles(self) -> int: ...
    @property
    def call_sites(self) -> int: ...

class Model:
    def __init__(self, version: int = ...) -> None: ...
    @staticmethod
    def read(data: collections.abc.Buffer) -> Model: ...
    @property
    def version(self) -> int: ...
    @property
    def pool_stats(self) -> PoolStats: ...
    @property
    def class_descriptors(self) -> list[str]: ...
    def copy_class(self, src: Model, descriptor: str) -> None: ...
    def copy_classes(self, src: Model, descriptors: list[str]) -> None: ...
    def write(self) -> bytes: ...

class BudgetError(ValueError): ...

class Request:
    def __init__(self, work: int = ..., storage: int = ...) -> None: ...
    def __enter__(self) -> Request: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...
    def charge(self, work: int = ..., storage: int = ...) -> None: ...
    @property
    def work(self) -> int: ...
    @property
    def storage(self) -> int: ...
    @property
    def backing(self) -> int: ...

def valid_class_name(name: str) -> bool: ...

class OutputLimit(ValueError): ...

def charge(work: int = ..., storage: int = ...) -> None: ...
